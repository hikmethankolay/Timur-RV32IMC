# =============================================================
#  Quartus + ModelSim/Questa .gitignore
#  Tracks: rtl/, tb/, vectors/, *.qsf, *.tcl, *.bat, *.qip, *.ppf
#  Ignores: all generated/compiled artifacts
# =============================================================

# ------------------------------------------------------------------
# Quartus compilation databases
# ------------------------------------------------------------------
db/
incremental_db/
greybox_tmp/

# ------------------------------------------------------------------
# Quartus output files  (reports, programming files, netlists)
# ------------------------------------------------------------------
output_files/

# Individual output extensions that may appear at project root
*.sof
*.pof
*.rbf
*.jic
*.ekp
*.jdi
*.jditmp
*.pin
*.done
*.rpt
*.smsg
*.summary
*.flow.rpt
*.eda.rpt
*.sta.rpt
*.sta.summary
*.asm.rpt
*.fit.rpt
*.fit.smsg
*.fit.summary
*.map.rpt
*.map.smsg
*.map.summary

# ------------------------------------------------------------------
# Quartus auto-generated backup / lock files
# ------------------------------------------------------------------
*.v.bak
*.qsf.bak
*.bak
*.orig
*.swp
*.lock

# Nativelink simulation report generated by Quartus
*_nativelink_simulation.rpt

# ------------------------------------------------------------------
# ModelSim / Questa compiled work libraries
# ------------------------------------------------------------------

# Root-level work library (used by run_tests.bat)
work/

# Questa EDA simulation output folder
simulation/questa/rtl_work/
simulation/questa/msim_transcript
simulation/questa/modelsim.ini

# Questa-generated netlist, stimulus, and run scripts
simulation/questa/*.vo
simulation/questa/*.sft
simulation/questa/*.do
simulation/questa/*.do.bak*

# ------------------------------------------------------------------
# ModelSim transcript and ini at project root
# ------------------------------------------------------------------
transcript
modelsim.ini

# Regression runner (run_tests.tcl): per-test logs, temporary do-files
logs/
*_run.do

# ------------------------------------------------------------------
# Miscellaneous generated files
# ------------------------------------------------------------------

# Timing / SignalTap
*.vcd
*.wlf
*.stp
*.signaltap
*.hal

# Tcl console history
*.tcl_history

# Windows thumbnail cache
Thumbs.db
desktop.ini

# Editor temp files
*.tmp
*~

# Documentation source files
*.docx
*.pdf
/tools/__pycache__
/sw/__pycache__

# C programs built by sw/build.py (the test images are committed in vectors/)
sw/build/
/.claude

# Build guide sources and PDF (private, like the design document)
docs/build-guide/

# Local toolchains (RISC-V GCC), not part of the project
.tools/
/docs
