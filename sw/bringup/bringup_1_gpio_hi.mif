-- Timur RV32IMC instruction ROM, HI bank (halfwords at byte offset 2 mod 4): bring-up, GPIO: LEDs mirror the switches
-- 16384 x 16-bit words; unused words are 0000 (illegal instruction)

DEPTH = 16384;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
    0000 : 4000;
    0001 : 2A50;
    0002 : 104A;
    0003 : 0000;
    0004 : 0001;
    0005 : 101A;
    0006 : FF1F;
    [0007..3FFF] : 0000;
END;
