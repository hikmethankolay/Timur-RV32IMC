# Memory map of the Timur SoC.
# Drawn from: rtl/bus/ahb_decoder.v (HADDR[31:16]), rtl/bus/ahb_apb_bridge.v
# (PADDR[15:8]), rtl/periph/*.v (PADDR[7:2]), sw/timur_tools/memmap.py
...@_style
grid-columns: 2
horizontal-gap: 96

classes: {
  region: {style: {font: mono; font-size: 13; bold: false; fill: "#ffffff"; stroke: "#a1a1aa"; stroke-width: 1; font-color: "#18181b"}}
  apbregion: {style: {font: mono; font-size: 13; bold: false; fill: "#eef2fd"; stroke: "#1d4ed8"; stroke-width: 2; font-color: "#18181b"}}
  gap: {style: {font: mono; font-size: 12; bold: false; fill: "#f4f4f5"; fill-pattern: lines; stroke: "#d4d4d8"; stroke-width: 1; font-color: "#71717a"}}
}

ahb: "AHB address space" {
  class: frame
  grid-columns: 1
  grid-gap: 0

  hi: "0x4001_0000 - 0xFFFF_FFFF\nunmapped: reads 0, writes ignored" {class: gap}
  apb: "0x4000_0000 - 0x4000_FFFF\nAPB peripherals (through the bridge)" {class: apbregion}
  g3: "0x3001_0000 - 0x3FFF_FFFF  unmapped" {class: gap}
  vga: "0x3000_0000 - 0x3000_FFFF\nVGA framebuffer, 38,400 bytes used" {class: region}
  g2: "0x2001_0000 - 0x2FFF_FFFF  unmapped" {class: gap}
  ram: "0x2000_0000 - 0x2000_FFFF\nRAM, 64 KB" {class: region}
  g1: "0x0001_0000 - 0x1FFF_FFFF  unmapped" {class: gap}
  rom: "0x0000_0000 - 0x0000_FFFF\nROM, 64 KB (fetch port and AHB port)" {class: region}
}

apb: "APB pages at 0x4000_0000" {
  class: frame
  grid-columns: 1
  grid-gap: 0

  uart: "+0x000  UART\nDATA 0x00, STATUS 0x04, CTRL 0x08" {class: region}
  gpio: "+0x100  GPIO\nOUT 0x00, IN 0x04, DIR 0x08" {class: region}
  dmac: "+0x200  DMAC\nSRC 0x00, DST 0x04, LEN 0x08\nCTRL 0x0C, STATUS 0x10" {class: region}
  vga: "+0x300  VGA\nCTRL 0x00, STATUS 0x04, SCROLL 0x08\nFRAME 0x0C, PALETTE 0x40-0x7C" {class: region}
  none: "+0x400 - 0xFFFF  no PSEL\nreads 0, completes at once" {class: gap}
  note: "Page on PADDR[15:8], register on PADDR[7:2].\nWord accesses only: APB3 has no byte strobes.\nThe AHB decoder looks at HADDR[31:16]." {class: note}
}

ahb.apb -> apb: {class: bus}
