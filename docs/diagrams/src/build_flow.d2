# From a C file to a programmed DE10-Lite.
# Drawn from: sw/build.py, sw/timur_tools/builder.py, romimage.py,
# sw/program_board.sh
...@_style
direction: down

src: "your program\napps/*.c" {class: file}
rt: "runtime\ncrt0.S, trap_entry.S, syscalls.c,\ntrap.c, uart.c, vga.c, linker.ld" {class: file}
gcc: "riscv-none-elf-gcc\nrv32imc_zicsr, newlib-nano\n--gc-sections" {class: tool}
elf: "program.elf\n.map, .lst" {class: file}
chk: "layout checks\n.text at 0, fits the ROM,\n.data in RAM" {class: step}
img: "ROM images\nrom.hex, rom_lo/hi.hex\nrom_lo/hi.mif" {class: key}
sim: "simulation\ntimur_soc_tb, reference model" {class: step}
q: "Quartus\nupdate MIF, assembler\n(full compile when RTL changed)" {class: tool}
sof: ".sof over JTAG\n.pof into flash" {class: file}
board: "DE10-Lite" {class: external}

src -> gcc: {class: wire}
rt -> gcc: {class: wire}
gcc -> elf: {class: bus}
elf -> chk: {class: bus}
chk -> img: "objcopy, banks" {class: bus}
img -> sim: {class: wire}
img -> q: "build.py --install" {class: bus}
q -> sof: {class: bus}
sof -> board: "program_board.sh" {class: bus}
