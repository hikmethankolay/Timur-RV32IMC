# The VGA controller: beam counters, the shared framebuffer read port, the
# pixel pipeline and the registers.
# Drawn from: rtl/periph/vga.v
...@_style
direction: down

ahb: "AHB slave (framebuffer)" {
  class: frame
  direction: down
  wr: "write port\ndata phase, byte lanes" {class: block}
  rd: "AHB reads\n1 wait state if they\nmeet the fetch slot" {class: block}
}

fb: "framebuffer\n4 lanes of 9600 x 8\n320 x 240 x 4 bit" {class: memory}

beam: "beam counters\nh 0-799, v 0-524\none pixel every 2 clocks" {class: block}
slot: "video fetch slot\none word (8 pixels)\nper 32 clocks, a word ahead" {class: control}

pix: "Pixel pipeline" {
  class: frame
  direction: right
  word: "cur_word\n8 pixels" {class: block}
  nib: "nibble h[3:1]\n4-bit index" {class: block}
  pal: "palette\n16 x 12-bit" {class: key}
  out: "vga_r, vga_g, vga_b\nvga_hs, vga_vs" {class: periph}
  word -> nib: {class: bus}
  nib -> pal: {class: bus}
  pal -> out: {class: bus}
}

regs: "APB registers\nCTRL, STATUS, SCROLL,\nFRAME, PALETTE" {class: periph}

ahb.wr -> fb: {class: bus}
ahb.rd <- fb: "read data" {class: wire}
beam -> slot: {class: ctl}
slot -> fb: "row + SCROLL, column" {class: ctl}
fb -> pix.word: "next_word" {class: bus}
beam -> pix.out: "HS, VS, blanking" {class: ctl}
regs -> pix.pal: {class: ctl}
