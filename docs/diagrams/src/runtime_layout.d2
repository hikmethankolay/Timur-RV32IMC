# Memory layout of a C program at run time.
# Drawn from: sw/runtime/linker.ld, sw/runtime/crt0.S
...@_style
grid-columns: 2
horizontal-gap: 140

classes: {
  sec: {style: {font-size: 13; bold: false; fill: "#ffffff"; stroke: "#a1a1aa"; stroke-width: 1; font-color: "#18181b"}}
  hot: {style: {font-size: 13; bold: false; fill: "#eef2fd"; stroke: "#1d4ed8"; stroke-width: 2; font-color: "#18181b"}}
  free: {style: {font-size: 12; bold: false; fill: "#f4f4f5"; fill-pattern: lines; stroke: "#d4d4d8"; stroke-width: 1; font-color: "#71717a"}}
}

rom: "ROM  0x0000_0000" {
  class: frame
  grid-columns: 1
  grid-gap: 0
  free: "unused" {class: free}
  dataimg: ".data load image (_data_load)" {class: hot}
  init: ".init_array" {class: sec}
  rodata: ".rodata, .srodata" {class: sec}
  text: ".text, _start at 0x0000_0000" {class: sec}
}

ram: "RAM  0x2000_0000" {
  class: frame
  grid-columns: 1
  grid-gap: 0
  stack: "stack, 8 KB by default\ngrows down from 0x2001_0000" {class: sec}
  heap: "heap\n_end up to _heap_end, grows up" {class: free}
  bss: ".sbss, .bss\ncleared by crt0" {class: sec}
  data: ".data, .sdata\ngp points 0x800 past .sdata" {class: hot}
}

rom.dataimg -> ram.data: "crt0 copies it at boot" {class: bus}
