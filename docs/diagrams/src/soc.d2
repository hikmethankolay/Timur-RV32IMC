# The Timur SoC on the DE10-Lite: every module, with the board pins it drives.
# Drawn from: rtl/top/Timur_RV32IMC.v, rtl/top/timur_soc.v, Timur_RV32IMC.qsf
...@_style
direction: down

wrapper: "Timur_RV32IMC  (board wrapper)" {
  class: frame
  pll: "cpu_pll\nMAX10_CLK1_50 in, 50 MHz out" {class: block}
  rst: "reset_sync\nKEY[0] and PLL locked" {class: block}

  soc: "timur_soc" {
    class: stage
    cpu: "CPU core\n5-stage RV32IMC pipeline\nCSRs, traps, decompressor" {class: key}
    cpum: "cpu_ahb_master\nmaster 0, priority" {class: block}
    dma: "dmac_ahb_master\nmaster 1" {class: block}
    fabric: "AHB-Lite fabric\narbiter, bus mux, decoder" {class: key}
    rom: "rom_ahb\n64 KB" {class: memory}
    ram: "ram_ahb\n64 KB" {class: memory}
    bridge: "ahb_apb_bridge" {class: block}
    vga: "vga\nVGA connector: RGB 4:4:4, HS, VS" {class: periph}
    uart: "uart_apb, 115200 8N1\nGPIO[0] tx, GPIO[1] rx" {class: periph}
    gpio: "gpio_apb\nSW[9:0] in, LEDR[9:0] out" {class: periph}
    dregs: "dmac_apb_regs" {class: periph}
    irqs: "external interrupt\nUART rx or DMA done" {class: control}

    cpu -> rom: "fetch port" {class: wire}
    cpu -> cpum: "loads, stores" {class: bus}
    cpum -> fabric: {class: bus}
    dma -> fabric: {class: bus}
    fabric -> rom: "data port" {class: bus}
    fabric -> ram: {class: bus}
    fabric -> vga: "framebuffer" {class: bus}
    fabric -> bridge: {class: bus}
    bridge -> uart: {class: wire}
    bridge -> gpio: {class: wire}
    bridge -> dregs: {class: wire}
    bridge -> vga: "registers" {class: wire}
    dma <- dregs: "start" {class: ctl}
    irqs <- uart: {class: irq}
    irqs <- dregs: {class: irq}
    cpu <- irqs: "mip.MEIP" {class: irq}
  }
  pll -> soc: "clk" {class: wire}
  pll -> rst: "locked" {class: wire}
  rst -> soc: "rst_n" {class: wire}
}
