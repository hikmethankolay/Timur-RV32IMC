# The five-stage pipeline: what each stage does and the registers between them.
# Drawn from: rtl/top/timur_soc.v (IF, ID, EX, MEM, WB sections),
# rtl/pipeline/*.v, rtl/decode/*.v, rtl/execute/*.v, rtl/csr/*.v
...@_style
direction: right

classes: {
  st: {width: 190; height: 170; style: {fill: "#ffffff"; stroke: "#a1a1aa"; stroke-width: 1; border-radius: 6; font-color: "#18181b"; font-size: 13}}
  stkey: {width: 190; height: 170; style: {fill: "#eef2fd"; stroke: "#1d4ed8"; stroke-width: 2; border-radius: 6; font-color: "#18181b"; font-size: 13}}
  reg: {width: 34; height: 170; style: {fill: "#e4e4e7"; stroke: "#52525b"; stroke-width: 1; border-radius: 6; font-color: "#3f3f46"; font-size: 11}}
}

if: "IF\n\npc\nPC + 2, PC + 4\nsplit-bank ROM fetch\n(32-bit window)\ndecompressor" {class: st}
r1: "IF/ID" {class: reg}
id: "ID\n\ninstr_parser, imm_gen\nmain_control_unit\nalu_decoder\nregisters (32 x 32)" {class: st}
r2: "ID/EX" {class: reg}
ex: "EX\n\nforwarding muxes\nALU, MUL, DIV\nbranch compare, redirect\nCSRs, trap decision" {class: stkey}
r3: "EX/MEM" {class: reg}
mem: "MEM\n\nstore_aligner\ncpu_ahb_master:\nAHB address phase" {class: st}
r4: "MEM/WB" {class: reg}
wb: "WB\n\nAHB data phase\nload_formatter\nregister write" {class: st}

if -> r1 -> id -> r2 -> ex -> r3 -> mem -> r4 -> wb: {class: bus}


hz: "Back paths: WB writes the register file in ID; EX/MEM and WB results are forwarded into EX; a taken branch, jump, MRET\nor trap redirects IF from EX. hazard_detection_unit holds or flushes every pipeline register (see the hazards diagram)." {
  class: note
  near: bottom-center
}
