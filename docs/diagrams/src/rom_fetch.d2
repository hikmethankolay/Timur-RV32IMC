# Split-bank ROM fetch: any halfword-aligned 32-bit window in one cycle.
# Drawn from: rtl/memory/rom_ahb.v, fetch indexes in rtl/top/timur_soc.v (IF)
...@_style

classes: {
  cell: {style: {font: mono; font-size: 13; bold: false; fill: "#ffffff"; stroke: "#a1a1aa"; stroke-width: 1; font-color: "#18181b"}}
  hit: {style: {font: mono; font-size: 13; bold: false; fill: "#eef2fd"; stroke: "#1d4ed8"; stroke-width: 2; font-color: "#18181b"}}
  head: {style: {font-size: 12; fill: "#ffffff"; stroke: "#ffffff"; font-color: "#52525b"}}
}

direction: right

idx: "fetch index\n{LO, HI, A[1]} for every candidate:\nPC, PC + 2, PC + 4,\nredirect target, mtvec" {class: block}

banks: "rom_ahb: two 16-bit banks" {
  class: frame
  grid-columns: 3
  grid-gap: 0
  h0: "" {class: head}
  h1: "word 0x40" {class: head}
  h2: "word 0x41" {class: head}
  rlo: "LO bank\noffset 0 mod 4" {class: head}
  lo40: "bytes\n0x100-0x101" {class: cell}
  lo41: "bytes\n0x104-0x105" {class: hit}
  rhi: "HI bank\noffset 2 mod 4" {class: head}
  hi40: "bytes\n0x102-0x103" {class: hit}
  hi41: "bytes\n0x106-0x107" {class: cell}
}

window: "fetch_window\nbytes 0x102-0x105\nto the decompressor" {class: key}

idx -> banks: "LO 0x41, HI 0x40\nA[1] = 1" {class: wire}
banks -> window: "one cycle" {class: bus}

rule: "The 32 bits at byte address A are LO[(A + 2) >> 2] and HI[A >> 2], ordered by A[1].\nHighlighted: a 32-bit instruction at 0x102 straddles two words and is still read in one cycle." {
  class: note
  near: bottom-center
}
