# Trap path: from the instruction in EX to the C handler and back with MRET.
# Drawn from: rtl/csr/trap_unit.v, rtl/csr/csr_file.v, rtl/top/timur_soc.v,
# sw/runtime/trap_entry.S, sw/runtime/trap.c
...@_style
direction: down

hw: "Hardware, in EX" {
  class: frame
  direction: right
  src: "causes\nexternal interrupt (UART rx, DMA done)\nillegal instruction, EBREAK, ECALL\nmisaligned load or store" {class: block}
  tu: "trap_unit\npicks one cause by priority;\nthe interrupt waits while MUL or DIV is in EX" {class: key}
  csr: "csr_file\nmepc = PC in EX, mcause, mtval\nMPIE = MIE, MIE = 0" {class: block}
  kill: "the trapping instruction and the\ntwo younger ones are cancelled;\nolder ones complete" {class: control}
  src -> tu: {class: wire}
  tu -> csr: "take_trap" {class: bus}
  tu -> kill: {class: ctl}
}

sw: "Software" {
  class: frame
  direction: right
  entry: "trap_entry.S\nat mtvec: save caller-saved registers\nin a trap frame on the stack" {class: file}
  disp: "timur_trap (trap.c)\ndispatch on mcause" {class: key}
  sys: "ECALL: system call\nread, write, exit\nmepc += 4" {class: block}
  irq: "interrupt: irq_handler\nmust clear its source" {class: block}
  exc: "exception: exception_handler\nor timur_fatal (report, stop)" {class: block}
  entry -> disp: {class: bus}
  disp -> sys: {class: wire}
  disp -> irq: {class: wire}
  disp -> exc: {class: wire}
}

mret: "restore registers, MRET:\nPC = mepc, MIE = MPIE" {class: control}

hw.csr -> sw.entry: "fetch from mtvec" {class: bus}
sw -> mret: {class: wire}
mret -> hw: "resume" {class: ctl}
