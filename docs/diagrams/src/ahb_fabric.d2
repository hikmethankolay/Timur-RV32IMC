# The AHB-Lite fabric: two masters, arbiter, bus mux, decoder, slaves.
# Drawn from: rtl/bus/ahb_arbiter.v, ahb_bus_mux.v, ahb_decoder.v,
# cpu_ahb_master.v, dmac_ahb_master.v; rtl/top/timur_soc.v
...@_style
direction: down

masters: "Masters" {
  class: frame
  cpum: "cpu_ahb_master\nmaster 0: loads and stores" {class: block}
  dmam: "dmac_ahb_master\nmaster 1: word copies" {class: block}
}

arb: "ahb_arbiter\nCPU first, then DMAC, else park on the CPU.\nOwnership moves only when HREADY = 1." {class: control}

mux: "ahb_bus_mux\naddress and control follow HMASTER\nHWDATA follows HMASTER_DATA" {class: key}

dec: "ahb_decoder\nHSEL from HADDR[31:16]\nselect registered for the data phase" {class: key}

slaves: "Slaves  (accept on HSEL and HTRANS[1] and HREADY)" {
  class: frame
  grid-rows: 1
  rom: "rom_ahb\nnever waits" {class: memory}
  ram: "ram_ahb\nnever waits" {class: memory}
  vga: "vga\n1 wait if a read\nmeets the video fetch" {class: periph}
  apb: "ahb_apb_bridge\nwaits in SETUP\nand until PREADY" {class: periph}
  def: "no HSEL\nreads 0, never waits" {class: unmapped}
}

ret: "return path\nHRDATA and HREADY of the selected slave" {class: block}

masters.cpum <-> arb: "HBUSREQ[0]\nHGRANT[0]" {class: ctl}
masters.dmam <-> arb: "HBUSREQ[1]\nHGRANT[1]" {class: ctl}
masters -> mux: "address, control, HWDATA" {class: bus}
arb -> mux: "HMASTER\nHMASTER_DATA" {class: ctl}
mux -> dec: "HADDR" {class: bus}
mux -> slaves: "address, control, HWDATA" {class: bus}
dec -> slaves: "HSEL_*" {class: wire}
slaves -> ret: "HRDATA_*, HREADYOUT_*" {class: wire}
dec -> ret: "sel_*_d" {class: ctl}
ret -> masters: "HRDATA, HREADY" {class: bus}
